{
	"name": "CROPS 24.04",
	"dockerComposeFile": "compose.yaml",
	"service": "yocto-dev",
	"workspaceFolder": "/workspace/yocto-hockey-poky",
	// Initialize the host machine
	"initializeCommand": {
		"createCacheDir": "mkdir -p \"${YOCTO_CACHE_DIR:-$HOME/projects/yocto-wrynose-caches}\"",
		// Create bind-mount sources in compose.yaml, else Docker creates them as directories
		"createMountSources": "mkdir -p ~/.ssh ~/.claude && touch ~/.zsh_history ~/.bash_history"
	},
	// Add ZSH support
	"features": {
		"ghcr.io/nils-geistmann/devcontainers-features/zsh:0": {
			"plugins": "git zsh-autosuggestions zsh-bitbake"
		}
	},
	"postCreateCommand": {
		"zshAutosuggestions": "git clone https://github.com/zsh-users/zsh-autosuggestions ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions",
		"zshBitbake": "git clone https://github.com/antznin/zsh-bitbake.git ~/.oh-my-zsh/custom/plugins/zsh-bitbake"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"yocto-project.yocto-bitbake",
				"streetsidesoftware.code-spell-checker",
				"mads-hartmann.bash-ide-vscode",
				"ms-python.vscode-pylance",
				"ms-python.python",
				"ms-python.debugpy",
				"ms-vscode.makefile-tools",
				"ms-vscode.cpptools-extension-pack",
				"wickscc.openembedded-kickstart",
				"plorefice.devicetree",
				"moshfeu.diff-merge",
				"ms-python.black-formatter",
				"kweihmann.oelint-vscode",
				"Anthropic.claude-code"
			],
			"settings": {
				// Disable auto save to limit the times Bitbake plugin spins up
				"files.autoSave": "off",
				// Enable format on manual save. This is format known types like .py files
				"editor.formatOnSave": true,
				"files.watcherExclude": {
					"**/bitbake-builds/*": true
				},
				"search.exclude": {
					"**/bitbake-builds/*": true
				},
				"C_Cpp.files.exclude": {
					"**/bitbake-builds/*": true
				},
				"python.analysis.exclude": [
					"**/bitbake-builds/*"
				],
				"git.repositoryScanIgnoredFolders": [
					"**/bitbake-builds/*"
				],
				// Upstream layers are not edited (use a bbappend in meta-hockey). Read-only
				// also stops oelint-vscode's fix-on-save from rewriting them.
				"files.readonlyInclude": {
					"**/bitbake-builds/*/layers/**": true
				},
				"terminal.integrated.defaultProfile.linux": "zsh",
				// The BitBake terminal always starts bash; ~/.bashrc execs zsh when this is set
				"bitbake.shellEnv": {
					"BITBAKE_ZSH": "1"
				},
				"files.associations": {
					"log.*": "log",
					"run.*": "python"
				},
				"oelint-vscode.run.fix": true,
				"oelint-vscode.run.mode": "all"
			}
		}
	}
}